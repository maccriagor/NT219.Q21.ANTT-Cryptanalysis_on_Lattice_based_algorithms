# Dockerfile.cryptopp — build Crypto++ tái lập (x86_64). Repo: github.com/weidai11/cryptopp
#   docker build -t cryptopp:x86 -f cryptopp_build/Dockerfile.cryptopp .
FROM debian:bookworm-slim

# Pin để tái lập
ARG CRYPTOPP_TAG=CRYPTOPP_8_9_0
# Cờ: -O2 ổn định để so sánh; đổi -O3, thêm -march=native (chỉ khi build & chạy CÙNG máy, KHÔNG portable)
ARG CXXFLAGS="-DNDEBUG -g2 -O2 -fPIC"
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git clone --depth 1 --branch ${CRYPTOPP_TAG} https://github.com/weidai11/cryptopp.git
WORKDIR /src/cryptopp

# static = libcryptopp.a · dynamic = libcryptopp.so · cryptest.exe = test + benchmark
RUN make -j"$(nproc)" CXXFLAGS="${CXXFLAGS}" static dynamic cryptest.exe \
 && make install PREFIX=/opt/cryptopp

# Ghi lại version + cờ (tái lập)
RUN { g++ --version | head -1; ld --version | head -1; \
      echo "CRYPTOPP_TAG=${CRYPTOPP_TAG}"; echo "CXXFLAGS=${CXXFLAGS}"; } > /opt/cryptopp/BUILD_INFO.txt && cat /opt/cryptopp/BUILD_INFO.txt

# Crypto++ có benchmark sẵn: cryptest.exe b <giây> <GHz>
CMD ["/src/cryptopp/cryptest.exe","b","3"]
