#Required version 
export OPENSSL_TAG="openssl-3.6.2"            # OpenSSL 3.6.2 (PQC native: ML-KEM/ML-DSA/SLH-DSA từ 3.5)
export LIBOQS_TAG="0.14.0"                    # hoặc 0.15.0
export OQSPROVIDER_TAG="0.10.0"
# Commit hash (điền sau lần build đầu bằng: git -C <repo> rev-parse HEAD)
export OPENSSL_COMMIT=""                      # vd: b1c3a... (40 hex)
export LIBOQS_COMMIT=""
export OQSPROVIDER_COMMIT=""

# Prefix cài đặt (KHÔNG đụng /usr)
export OSSL_PREFIX="/opt/openssl-3.6.2"
export LIBOQS_PREFIX_REF="/opt/liboqs-ref"   # cây reference C (đối chứng WP3)
export LIBOQS_PREFIX_OPT="/opt/liboqs-neon"  # cây NEON-optimized
export PROVIDER_PREFIX="/opt/oqs-provider-0.10.0"
export JOBS="$(nproc)"