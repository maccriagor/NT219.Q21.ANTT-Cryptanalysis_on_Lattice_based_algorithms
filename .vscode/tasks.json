{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "PQC: compile active file (Docker)",
            "type": "process",
            "command": "docker",
            "args": [
                "run", "--rm",
                "-v", "${workspaceFolder}:/work",
                "-w", "/work",
                "pqc:wp1-amd64",
                "bash", "scripts/compile.sh", "${relativeFile}"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": ["relative", "${workspaceFolder}"]
            },
            "detail": "Biên dịch file đang mở trong Docker (liboqs + OpenSSL 3.6.2). Binary ra cạnh file nguồn."
        },
        {
            "label": "PQC: compile & run active file (Docker)",
            "type": "process",
            "command": "docker",
            "args": [
                "run", "--rm",
                "-v", "${workspaceFolder}:/work",
                "-w", "/work",
                "pqc:wp1-amd64",
                "bash", "scripts/compile.sh", "--run", "${relativeFile}"
            ],
            "group": "build",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": ["relative", "${workspaceFolder}"]
            },
            "detail": "Biên dịch rồi chạy luôn trong Docker."
        }
    ]
}
